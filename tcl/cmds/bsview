proc BuildSumTable { } {
    toplevel .sum
    wm withdraw .sum
    label .sum.l -width 30 -height 20 -font fixed -justify left -anchor nw
    frame .sum.b
    button .sum.b.dismiss -text "Dismiss" -command HideSumTable
    button .sum.b.print -text "Print" -command PrintSum
    pack .sum.l .sum.b -side top -expand true -fill x
    pack .sum.b.dismiss .sum.b.print -in .sum.b -side left -fill x -expand true
}

proc HideSumTable {} {
    wm withdraw .sum
}

proc ShowSumTable {} {
    wm deiconify .sum
}

proc PrintSum {} {
    global lprcmd
    set output [lindex [.sum.l configure -text] end]
    if [catch { eval exec echo $output | $lprcmd } result] {
	PutText $result
    }
}

proc ListSum { } {
    global ydet xdet mode dets chans livetime view

    set output ""
    if {$livetime > 1.0} {
	set ltime [expr $livetime / 60.0]
    } else {
	set ltime 1.0
    }
    append output "Live Time(min):    "
    append output [format "%10.2f\n" $ltime]
    append output "Det   Counts(raw) Rate(c/min)\n"
    for {set i 0} {$i < 17} {incr i} {
	append output [format " %2.0f" $xdet($i)]
	append output [format " %12.0f" $ydet($i)]
	append output [format " %12.2f" [expr $ydet($i) / $ltime]]
	append output "\n"
    }
    set trate 0.0
    for {set i 5} {$i < 17} {incr i} { set trate [expr $trate + $ydet($i)]}
    append output "Rate (5-16):     "
    append output [format "%12.2f" [expr $trate / $ltime]]
    return $output
}


proc ReadHFBS { filename } {
    global livetime total fullsize mode runinfo

    # Reset runinfo variables
    set runinfo(filename)  ""
    set runinfo(tottime)   0.0
    set runinfo(starttime) "01-Jan-1970 00:00:00"
    set runinfo(mode)      pst
    set runinfo(comments)  ""
    set runinfo(timebin)   30
    set runinfo(user)      anonymous

    if [catch {open $filename r} infile] {
	return -code error $infile
    }
    set runinfo(filename) $filename
    set curdet -1
    while {[gets $infile line] >= 0} {
	if [regexp {^#} $line] {
	    if [regexp {^#Live([^:]*):(.*)} $line match spaces livetime] {
		set livetime [expr 1.0 * $livetime]
		set runinfo(tottime) $livetime
	    }
	    if [regexp {^#Start([^:]*):(.*)} $line match spaces starttime] {
		set runinfo(starttime) $starttime
	    }
	    if [regexp {^#Comments([^:]*):(.*)} $line match spaces comments] {
		set runinfo(comments) $comments
	    }
	    if [regexp {^#User([^:]*):(.*)} $line match spaces user] {
		set runinfo(user) $user
	    }
	    if [regexp {^#Time([^:]*):(.*)} $line match spaces timebin] {
		set runinfo(timebin) $timebin
	    }	    
	    if [regexp {^#Run Mode([^:]*):(.*)} $line match spaces vmemode] {
		set mode [string trimleft [string trimright $vmemode]]
		set runinfo(mode) $mode
		switch $mode {
		    pst {}
		    time {}
		    velocity {}
		    default {
			close $infile
			return "ERR:\nUnrecognized mode"
		    }
		}
		fullsize export {0 0} {20 4096} total
	    }
	    if [regexp {^# Detector(.*)} $line match det] {
		set curdet [expr 1 * $det]
	    }
	} else {
	    if {$curdet < 0} { continue }
	    if {[scan $line "%d %f" chan val] == 2} {
		total aset $curdet $chan $val
	    }
	}
    }
    close $infile
    return $filename
}

proc OpenData { {infile {}} } {
    global total detlabel xs y .g mode chans dets \
	    veclen view knownmodes

    set types {
	{{HFBS Files}       {.hfbs}        HFBS} 
	{{All Files}        *             }
    }
    if {[string length $infile] == 0} {
	set filename [tk_getOpenFile -initialdir /home/hfbs/data \
		-filetypes $types]
    } else {
	set filename $infile
    }
    if {[string length $filename] == 0} { return } 
    PutText "Reading data: please wait"
    BusyCursorOn
    update
    if [catch {ReadHFBS $filename} result] {
	PutText $result
	return
    }
    PutText ""
    BusyCursorOff
    update
    
    set veclen $chans($mode)
    set sub [expr $chans($mode) / 1024]

    set view(integrate_done) 0
    set view(norm_smpl_done) 0
    set view(norm_mon_done)  0
    SplitMats
    Integrate

    # Apply view options

    if {$view(norm_smpl)} { NormalizeSample  }
    if {$view(norm_mon) } { NormalizeMonitor }
    ShowNewDet $view(currentdet) 

    return 0
}

proc Integrate { } {
    global ydet xdet control chans view livetime mode

    PutText "Integrating over velocity/PST channels."
    BusyCursorOn
    update
    
    data collapse {0 1} hvec
    narray2vec hvec x ydet
    .sum.l configure -text [ListSum]
    set ydet(0) 0 ;# Kludge for high counts in monitor channel
    PutText ""
    BusyCursorOff
    update
    set view(integrate_done) 1
    return $view(integrate_done)
}

#
# Split block of data received from VME system into portions suitable for
# writing to a file.
#
proc SplitMats { } {
    global logs mode total work2 control livetime dets chans view
    
    PutText "Processing raw data"
    BusyCursorOn
    update

    mtx split $mode total data pv xvec
    pv export {0 0} [pv dimensions] normalize
    PutText ""
    BusyCursorOff
    update
    return 0
}

proc BusyCursorOn {} {
    . configure -cursor watch
    .g configure -cursor watch
}

proc BusyCursorOff {} {
    . configure -cursor {}
    .g configure -cursor crosshair
}

#
# Normalize data to sample histograms
#
proc NormalizeSample { } {
    global ydet xdet mode chans livetime view

    PutText "Normalizing to sample histograms."
    BusyCursorOn
    update
    # Multiply []/$normalize[] by 50000 to get rate in C/s
    # Multiply []/$normalize[] by 50000/60=833.33 to get rate in C/min
    data map {
	$normalize[] < 0.000000001 ? [] = 0 : [] = $[] * 833.33 / $normalize[];
    } {normalize normalize}

    PutText ""
    BusyCursorOff
    update
    set view(norm_smpl_done) 1
    return $view(norm_smpl_done)
}

#
# Normalize data to monitor
#
proc NormalizeMonitor { } {
    global mode chans livetime view

    # if {!$view(norm_smpl_done)} { NormalizeSample }
    PutText "Normalizing to monitor."
    BusyCursorOn
    update
    # Fill narray normalize with values from monitor channel
    data export {0 0} [list 1 $chans($mode)] work2
    for {set i 0} {$i < 20} {incr i} {
	normalize import [list $i 0] work2
    }

    data map { 
	$normalize[] < 0.000001 ? divisor = 1 : divisor = $normalize[]; 
	[] /= $divisor; 
    } {normalize normalize}

    PutText ""
    BusyCursorOff
    update
    set view(norm_mon_done) 1
    return $view(norm_mon_done)
}

# Print a list of sums over all velocity/PST channels

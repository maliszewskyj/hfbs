proc PrintGraph { } {
    global .g lprcmd buffer view
    set bufno 0
    set outfile "/tmp/hfbs[pid].ps"
    if [catch {.g postscript output $outfile}] {
	PutText "Cannot create postscript output"
	return
    }

    set detstring ""
    switch $view(currentdet) {
	all { set detstring all }
	0 { set detstring monitor }
	sum {
	    for {set i 0} {$i < 17} {incr i} {
		if {[string length $detstring] > 0} {
		    append detstring ","
		}
		if { $view($i) } { append detstring $i }
	    }
	}
    }

    # Prepend buffer information to hardcopy
    set finalfile "/tmp/hfbs[pid]x.ps"

    set f [open $finalfile w]
    puts $f "%!PS"
    puts $f "gsave"
    puts $f "/Times-Roman findfont 8 scalefont setfont"
    puts $f "792 0 translate 90 rotate"
    set timestring [format "%.2f " $buffer(0,tottime)]
    puts $f " 72 729 moveto (Buffer 0:) show"
    puts $f "144 729 moveto ($buffer(0,filename)) show"
    puts $f "288 729 moveto ($buffer(0,starttime)) show"
    puts $f "396 729 moveto ($buffer(0,mode)) show"
    puts $f "432 729 moveto ($timestring sec) show"
    puts $f "144 720 moveto ($buffer(0,comments)) show"
    set timestring [format "%.2f " $buffer(1,tottime)]
    puts $f " 72 711 moveto (Buffer 1:) show"
    puts $f "144 711 moveto ($buffer(1,filename)) show"
    puts $f "288 711 moveto ($buffer(1,starttime)) show"
    puts $f "396 711 moveto ($buffer(1,mode)) show"
    puts $f "432 711 moveto ($timestring sec) show"
    puts $f "144 702 moveto ($buffer(1,comments)) show"
    set timestring [format "%.2f " $buffer(2,tottime)]
    puts $f " 72 693 moveto (Buffer 2:) show"
    puts $f "144 693 moveto ($buffer(2,filename)) show"
    puts $f "288 693 moveto ($buffer(2,starttime)) show"
    puts $f "396 693 moveto ($buffer(2,mode)) show"
    puts $f "432 693 moveto ($timestring sec) show"
    puts $f "144 684 moveto ($buffer(2,comments)) show"
    set timestring [format "%.2f " $buffer(3,tottime)]
    puts $f " 72 675 moveto (Buffer 3:) show"
    puts $f "144 675 moveto ($buffer(3,filename)) show"
    puts $f "288 675 moveto ($buffer(3,starttime)) show"
    puts $f "396 675 moveto ($buffer(3,mode)) show"
    puts $f "432 675 moveto ($timestring sec) show"
    puts $f "144 666 moveto ($buffer(3,comments)) show"
    set timestring [format "%.2f " $buffer(4,tottime)]
    puts $f " 72 657 moveto (Buffer 4:) show"
    puts $f "144 657 moveto ($buffer(4,filename)) show"
    puts $f "288 657 moveto ($buffer(4,starttime)) show"
    puts $f "396 657 moveto ($buffer(4,mode)) show"
    puts $f "432 657 moveto ($timestring sec) show"
    puts $f "144 648 moveto ($buffer(4,comments)) show"
    puts $f " 72 639 moveto (Detectors:) show "
    puts $f "144 639 moveto ($detstring) show"
    puts $f "grestore"
    close $f
    unset f

    if [catch {exec cat $outfile >> $finalfile} result] {
	PutText $result
    }

    if [catch {eval exec $lprcmd $finalfile} result] {
	PutText $result
    }
    catch {exec rm -f $outfile} result
#    catch {exec rm -f $finalfile} result
}

proc ShowNewDet { d } {
    global xs chans dets view buffer

    if {[string compare $d "all"] == 0} {
	if {!$view(integrate_done)} { 
	    for {set i 0} {$i < $buffer(nbuf)} {incr i} {
		if {$buffer($i,active)} { Integrate $i }
	    }
	}
	ordinal export 0 20 hvec
	narray2vec hvec x xs
	for {set i 0} {$i < $buffer(nbuf)} {incr i} {
	    if {$buffer($i,active)} {
		.g element configure e0 -xdata xs -ydata $buffer($i,ydet)
	    }
	}
	.g xaxis configure -title "Detector"
	set view(currentdet) all
	return 
    } elseif {[string compare $d "sum"] == 0} {
	set detlabel "Det: sum"
	set view(currentdet) $d
	set ndets 0
	for {set i 0} {$i < 20} {incr i} {
	    lappend mask $view($i)
	    if {$view($i)} { incr ndets }
	}
	if {$view(norm_mon)} {
	    .g yaxis configure -title "Counts/Monitor"
	} elseif {$view(norm_smpl)} {
	    .g yaxis configure -title "Rate (Counts/min)"
	} else {
	    .g yaxis configure -title "Counts"
	}

	switch $buffer(current_mode) {
	    teach {
		ordinal export 0 4096 hvec
		narray2vec hvec x xs
		.g xaxis configure -title "PST Channel"
	    }
	    standard {
		narray2vec energy x xs
		.g xaxis configure -title "Energy (ueV)"
	    }
	    hybrid {
		ordinal export 0 2048 hvec
		hvec map {[] = 2 * $[];}
		narray2vec hvec x xs
		.g xaxis configure -title "PST Channel"
	    }
	    default {
		return -code error "ERR:\nBad mode"
	    }
	}
	for {set i 0} {$i < $buffer(nbuf)} {incr i} {
	    if {$buffer($i,active)} {
		$buffer($i,data) collapse {1 0} $mask hvec
		if {$ndets > 0} {
		    hvec vset ndets $ndets
		    hvec map {[] /= $ndets;}
		}
		narray2vec hvec x $buffer($i,y)
		.g element configure e$i -xdata xs -ydata $buffer($i,y)
	    }
	}
    } elseif [regexp {sample(.*)} $d match s_typ] {
	switch $s_typ {
	    mon {
		if {[string compare $buffer(current_mode) "teach"]==0} {
		    set sampledet 19
		} else {
		    set sampledet 20
		}
	    }
	    lo {
		if {[string compare $buffer(current_mode) "standard"] || \
			[string compare $buffer(current_mode) "hybrid"]} {
		    return -code error "ERR:\nNot available in this mode"
		}
		set sampledet 21
	    }
	    hi {
		if {[string compare $buffer(current_mode) "standard"] || \
			[string compare $buffer(current_mode) "hybrid"]} {
		    return -code error "ERR:\nNot available in this mode"
		}
		set sampledet 22
	    }
	    default {
		return -code error "ERR:\nSampling type not available"
	    }
	}

	set view(currentdet) $d
	if {$view(norm_mon)} {
	    .g yaxis configure -title "Counts/Monitor"
	} elseif {$view(norm_smpl)} {
	    .g yaxis configure -title "Rate (Counts/min)"
	} else {
	    .g yaxis configure -title "Counts"
	}
	switch $buffer(current_mode) {
	    teach {
		ordinal export 0 4096 hvec
		narray2vec hvec x xs
		.g xaxis configure -title "PST Channel"
	    }
	    hybrid {
		ordinal export 0 4096 hvec
		narray2vec hvec x xs
		.g xaxis configure -title "PST Channel"
	    }
	    standard {
		narray2vec energy x xs
		.g xaxis configure -title "Energy (ueV)"
	    }
	    default {
		return -code error "ERR:\nBad mode"
	    }
	}
	for {set i 0} {$i < $buffer(nbuf)} {incr i} {
	    if {$buffer($i,active)} {
		narray2vec $buffer($i,total) $sampledet x $buffer($i,y)
		.g element configure e$i -xdata xs -ydata $buffer($i,y)
	    }
	}
    } else {
	if {$d >= $dets($buffer(current_mode))} {
	    PutText "ERR:\nRequested detector out of bounds"
	    return
	}
	switch $buffer(current_mode) {
	    teach {
		ordinal export 0 4096 hvec
		narray2vec hvec x xs
		.g xaxis configure -title "PST Channel"
	    }
	    standard {
		narray2vec energy x xs
		.g xaxis configure -title "Energy (ueV)"
	    }
	    hybrid {
		ordinal export 0 2048 hvec
		hvec map {[] = 2 * $[];}
		narray2vec hvec x xs
		.g xaxis configure -title "PST Channel"
	    }
	    default {
		return -code error "ERR:\nBad mode"
	    }
	}
	set view(currentdet) $d
	if {$view(norm_mon)} {
	    .g yaxis configure -title "Counts/Monitor"
	} elseif {$view(norm_smpl)} {
	    .g yaxis configure -title "Rate (Counts/min)"
	} else {
	    .g yaxis configure -title "Counts"
	}
	for {set i 0} {$i < $buffer(nbuf)} {incr i} {
	    if {$buffer($i,active)} {
		narray2vec $buffer($i,data) $d x $buffer($i,y)
		.g element configure e$i -xdata xs -ydata $buffer($i,y)
	    }
	}

    }
}

proc PutText { input } {
    .t configure -text $input
}

proc AppendText { input } {
    set displaytext [.t configure -text]
    if {[string length $displaytext] > 0} {
	append displaytext "\n"
    }
    append displaytext $input
    .t configure -text $displaytext
}

proc BufferPanelBuild { f } {
    global buffer

    if [catch {frame $f} result] {
	return -code error $result
    }

    label $f.numlab  -text "#"
    label $f.plotlab -text "Plot"
    label $f.filelab -text "Filename"  -width 20
    label $f.commlab -text "Comments"  -width 60
    label $f.timelab -text "Time(sec)" -width 12
    label $f.delelab -text "Delete"

    grid $f.numlab  -row 0 -column 0
    grid $f.plotlab -row 0 -column 1
    grid $f.filelab -row 0 -column 2 -sticky w
    grid $f.commlab -row 0 -column 3 -sticky w
    grid $f.timelab -row 0 -column 4 -sticky w
    grid $f.delelab -row 0 -column 5

    for {set i 0} {$i < $buffer(nbuf)} {incr i} {
	label $f.num$i -text $i -foreground [lindex $buffer(colors) $i]
	set buffer($i,showwid) [checkbutton $f.plot$i \
		-variable buffer($i,show) -text "" -command "BufferToggle $i" ]
	label $f.file$i -textvariable buffer($i,filename) -anchor w
	label $f.comm$i -textvariable buffer($i,comments) -anchor w
	label $f.time$i -textvariable buffer($i,tottime) -anchor e
	button $f.dele$i -image skull -padx 0 -pady 0 -command "BufferDelete $i"
	set row [expr $i + 1]
	grid $f.num$i  -row $row -column 0 
	grid $f.plot$i -row $row -column 1
	grid $f.file$i -row $row -column 2 -sticky w
	grid $f.comm$i -row $row -column 3 -sticky w
	grid $f.time$i -row $row -column 4 -sticky e
	grid $f.dele$i -row $row -column 5
    }
    return $f
}

proc BufferDelete { bufno } {
    global buffer chans dets
    PutText "Deleting contents of buffer $bufno"
    # set y and ydet to zero
    # clear narrays
    # set array variables to initialized values
    narray2vec hvec x $buffer($bufno,y)
    for {set i 0} {$i < 20} {incr i} {
	set $buffer($bufno,ydet) 0.0
    }
    BufferHide $bufno
    set buffer($bufno,filename) -empty-
    set buffer($bufno,tottime)  0.0
    set buffer($bufno,starttime) "01-Jan-1970 00:00:00"
    set buffer($bufno,mode)     teach
    set buffer($bufno,comments) ""
    
    set buffer($bufno,active)   0
    set buffer(nactive) [expr $buffer(nactive) - 1]
    if {0 == $buffer(nactive)} {
	set buffer(current_mode) null
    }
    update
}

proc BufferToggle { bufno } {
    global buffer
    if {$buffer($bufno,show)} {
	BufferShow $bufno
    } else {
	BufferHide $bufno
    }
}

proc BufferShow { bufno } {
    global buffer
    if {$buffer($bufno,active)} {
	.g element configure e$bufno -hide 0
	set buffer($bufno,show) 1
    }
}

proc BufferHide { bufno } {
    global buffer
    if {$buffer($bufno,active)} {
	.g element configure e$bufno -hide 1
	set buffer($bufno,show) 0
    }
}


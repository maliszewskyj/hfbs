proc ReadHFBS { bufno filename } {
    global buffer fullsize

    if {$bufno >= $buffer(nbuf)} {
	return -code error "Invalid buffer number"
    }

    # Reset buffer variables
    set buffer($bufno,filename)  -empty-
    set buffer($bufno,tottime)   0.0
    set buffer($bufno,starttime) "01-Jan-1970 00:00:00"
    set buffer($bufno,mode)      teach
    set buffer($bufno,comments)  ""

    if [catch {open $filename r} infile] {
	return -code error $infile
    }
    if [regexp {/([^/]+)$} $filename match bfile] {
	set buffer($bufno,filename) $bfile
    } else {
	set buffer($bufno,filename) $filename
    }
    set curdet 0
    while {[gets $infile line] >= 0} {
	if [regexp {^#} $line] {
	    if [regexp {^#Live([^:]*):(.*)} $line match spaces livetime] {
		set livetime [expr 1.0 * $livetime]
		set buffer($bufno,tottime) $livetime
	    }
	    if [regexp {^#Start([^:]*):(.*)} $line match spaces starttime] {
		set buffer($bufno,starttime) $starttime
	    }
	    if [regexp {^#Comments([^:]*):(.*)} $line match spaces comments] {
		set buffer($bufno,comments) $comments
	    }
	    if [regexp {^#Run Mode([^:]*):(.*)} $line match spaces vmemode] {
		set mode [string trimleft [string trimright $vmemode]]
		if {![string compare $buffer(current_mode) null]} {
		    set buffer(current_mode) $mode
		} else {
		    if [string compare $buffer(current_mode) $mode] {
			set buffer($bufno,comments) ""
			set buffer($bufno,tottime)  0.0
			set buffer($bufno,starttime) "01-Jan-1970 00:00:00"
			set buffer($bufno,filename)  -empty-
			return -code error \
			    "ERR:\nBuffer is not in $buffer(current_mode) mode"
		    }
		}
		set buffer($bufno,mode) $mode
		switch $mode {
		    standard {
			fullsize export {0 0} {23 2048} $buffer($bufno,total)
		    }
		    teach {
			fullsize export {0 0} {20 4096} $buffer($bufno,total)
		    }
		    hybrid {
			fullsize export {0 0} {23 2048} $buffer($bufno,total)
		    }
		    default {
			close $infile
			return "ERR:\nUnrecognized mode"
		    }
		}
	    }
	    if [regexp {^# Detector(.*)} $line match det] {
		set curdet [expr 1 * $det]
	    }
	} else {
	    if {[scan $line "%d %f" chan val] == 2} {
		$buffer($bufno,total) aset $curdet $chan $val
	    }
	}
    }
    close $infile
    return $filename
}

proc OpenData { bufno {infile {}} } {
    global buffer chans dets view knownmodes

    if {$bufno > $buffer(nbuf)} {
	PutText "ERR:\nBuffer number $bufno out of range"
	return
    }

    set types {
	{{HFBS Files}       {.hfbs}        HFBS} 
	{{All Files}        *             }
    }

    if {[string length $infile] == 0} {
	set filename [tk_getOpenFile -initialdir /home/hfbs/data \
		-filetypes $types]
    } else {
	set filename $infile
    }
    if {[string length $filename] == 0} { return } 
    PutText "Reading data: please wait"
    BusyCursorOn
    update
    if [catch {ReadHFBS $bufno $filename} result] {
	PutText $result
	return
    }
    PutText ""
    BusyCursorOff
    update
    
    set veclen $chans($buffer($bufno,mode))

    set view(integrate_done) 0
    set view(norm_smpl_done) 0
    set view(norm_mon_done)  0
    Integrate $bufno
    SplitMats $bufno

    #Make a pretty picture to display
    #set sub [expr $chans($mode) / 1024]
    #data export { 1 0} [list 16 $chans($mode)] work2
    #work2 map {[] = log($[] + 1); }
    #img configure -data work2
    #imgy copy img -zoom 1 6
    #imgz copy imgy -subsample [expr $chans($mode) / 1024] 1

    set buffer($bufno,active) 1
    incr buffer(nactive)

    # Apply view options

    if {$view(norm_smpl)} { NormalizeSample  $bufno}
    if {$view(norm_mon) } { NormalizeMonitor $bufno}
    .g element configure e$bufno -label $buffer($bufno,filename)
    BufferShow $bufno
    #.g element configure e$bufno -hide 0 -label $buffer($bufno,filename)
    ShowNewDet $view(currentdet) 

    return 0
}

proc Integrate { bufno } {
    global xdet chans livetime view buffer

    PutText "Integrating over velocity/PST channels."
    global $buffer($bufno,ydet)
    BusyCursorOn
    update
    $buffer($bufno,total) collapse {0 1} hvec
    hvec export 0 20 hsum
    narray2vec hsum x $buffer($bufno,ydet)
    #.sum.l configure -text [ListSum]
    # Kludge for high counts in monitor and unconnected channels
    set buffer($bufno,monitor) [set "$buffer($bufno,ydet)(0)"]
    set "$buffer($bufno,ydet)(0)" 0
    set "$buffer($bufno,ydet)(19)" 0
    PutText ""
    BusyCursorOff
    update
    set view(integrate_done) 1
    return $view(integrate_done)
}

#
# Split block of data received from VME system into portions suitable for
# writing to a file.
#
proc SplitMats { {bufno 0} } {
    global logs work2 dets chans view buffer

    PutText "Processing raw data for buffer $bufno"
    BusyCursorOn
    update
    $buffer($bufno,total) export {0 0} [list 20 $chans($buffer($bufno,mode))] \
	    $buffer($bufno,data)
    $buffer($bufno,total) export {0 0} [list 20 $chans($buffer($bufno,mode))] \
	    $buffer($bufno,norm)
    switch $buffer($bufno,mode) {
	teach {
	    # Build normalization histogram
	    $buffer($bufno,total) export {19 0} {1 4096} work2
	    for {set i 0} {$i < 20} {incr i} {
		$buffer($bufno,norm) import [list $i 0] work2
	    }
	    work2 map {[] = 0;}
	    $buffer($bufno,data) import {19 0} work2
	}
	standard {
	    # Build monitor sample histogram
	    $buffer($bufno,total) export {20 0} {1 2048} work2
	    $buffer($bufno,norm) import {0 0} work2
	    # Build low angle detector sample histogram
	    $buffer($bufno,total) export {21 0} {1 2048} work2
	    for {set i 1} {$i < 5} {incr i} {
		$buffer($bufno,norm) import [list $i 0] work2
	    }
	    # Build high angle detector sample histogram
	    $buffer($bufno,total) export {22 0} {1 2048} work2
	    for {set i 5} {$i < 20} {incr i} {
		$buffer($bufno,norm) import [list $i 0] work2
	    }
	}
	hybrid {
	    # Build monitor sample histogram
	    $buffer($bufno,total) export {20 0} {1 2048} work2
	    $buffer($bufno,norm) import {0 0} work2
	    # Build low angle detector sample histogram
	    $buffer($bufno,total) export {21 0} {1 2048} work2
	    for {set i 1} {$i < 5} {incr i} {
		$buffer($bufno,norm) import [list $i 0] work2
	    }
	    # Build high angle detector sample histogram
	    $buffer($bufno,total) export {22 0} {1 2048} work2
	    for {set i 5} {$i < 20} {incr i} {
		$buffer($bufno,norm) import [list $i 0] work2
	    }
	}
	default {
	    BusyCursorOff
	    return -code error "Available modes : standard teach hybrid"
	}
    }
    PutText ""
    BusyCursorOff
    update
    return 0
}

proc BusyCursorOn {} {
    . configure -cursor watch
    .g configure -cursor watch
}

proc BusyCursorOff {} {
    . configure -cursor {}
    .g configure -cursor crosshair
}

#
# Normalize data to sample histograms
#
proc NormalizeSample { {bufno 0} } {
    global xdet view buffer

    PutText "Normalizing buffer $bufno to sample histograms."
    BusyCursorOn
    update
    # Multiply []/$normalize[] by 50000 to get rate in C/s
    # Multiply []/$normalize[] by 50000/60=833.33 to get rate in C/min
    $buffer($bufno,data) map {
	$normalize[] < 0.000000001 ? [] = 0 : [] = $[] * 833.33 / $normalize[];
    } [list normalize $buffer($bufno,norm)]

    PutText ""
    BusyCursorOff
    update
    set view(norm_smpl_done) 1
    return $view(norm_smpl_done)
}

#
# Normalize data to monitor
#
proc NormalizeMonitor {{bufno 0} } {
    global chans view buffer

    # if {!$view(norm_smpl_done)} { NormalizeSample }
    PutText "Normalizing buffer $bufno to monitor."
    BusyCursorOn
    update
    # Fill narray normalize with values from monitor channel
    $buffer($bufno,data) export {0 0} \
	    [list 1 $chans($buffer($bufno,mode))] work2
    for {set i 0} {$i < 20} {incr i} {
	$buffer($bufno,norm) import [list $i 0] work2
    }

    $buffer($bufno,data) map { 
	$normalize[] < 0.000001 ? divisor = 1 : divisor = $normalize[]; 
	[] /= $divisor; 
    } [list normalize $buffer($bufno,norm)]

    PutText ""
    BusyCursorOff
    update
    set view(norm_mon_done) 1
    return $view(norm_mon_done)
}


    pack .sum.b.dismiss .sum.b.print -in .sum.b -side left -fill x -expand true
}

proc HideSumTable {} {
    wm withdraw .sum
}

proc ShowSumTable { bufno } {

    if [catch {ListSum $bufno} result] {
	PutText $result
	return
    }
    .sum.l configure -text $result
    wm deiconify .sum
}

proc PrintSum {} {
    global lprcmd
    set output [lindex [.sum.l configure -text] end]
    if [catch { exec echo $output | lpr } result] {
	PutText $result
    }
}

proc ListSum { {bufno 0} } {
    global xdet mode dets chans view buffer

    if {!$buffer($bufno,active)} {
	return -code error "ERR:\nBuffer $bufno has no data!"
    }
    global $buffer($bufno,ydet)
    set output "$buffer($bufno,filename)\n"
    if {$buffer($bufno,tottime) > 1.0} {
	set ltime [expr $buffer($bufno,tottime) / 60.0]
    } else {
	set ltime 1.0
    }
    set monitor $buffer($bufno,monitor)
    if {$monitor <= 0.0} {
	set monitor 1.0
    } 
    append output "Live Time(min):    "
    append output [format "%10.2f\n" [expr $buffer($bufno,tottime) / 60.0]]
    append output "Monitor       :  "
    append output [format "%12.0f\n" $monitor]
    append output "Det   Counts(raw) Rate(c/mon)\n"
    for {set i 1} {$i < 17} {incr i} {
	append output [format " %2.0f"  $xdet($i)]
	append output [format " %12.0f" [set "$buffer($bufno,ydet)($i)"]]
	append output [format " %9.4fE-4" \
		[expr ([set "$buffer($bufno,ydet)($i)"] * 10000.0)/ $monitor]]
	append output "\n"
    }
    set trate 0.0
    for {set i 5} {$i < 17} {incr i} { set trate [expr $trate + \
	    [set "$buffer($bufno,ydet)($i)"]]}
    append output "Rate (5-16):     "
    append output [format "%9.4fE-4" [expr ($trate*10000.0) / $monitor]]
    return $output
}


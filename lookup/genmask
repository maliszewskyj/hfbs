@mon_tr      = ( 460,1020,1825,2380,3175,3750);
@det_lo_tr   = ( 320, 880,1685,2250,3040,3630);
@det_hi_tr   = ( 325, 900,1675,2270,3040,3640);

sub FlipFlop {
    local($flag) = @_;

    if ($flag) { 
	return 0; 
    } else {
	return 1;
    }
}

$det_hi_idx = 0;
$det_lo_idx = 0;
$mon_idx    = 0;
$det_hi_val = $det_hi_init;
$det_lo_val = $det_lo_init;
$mon_val    = $mon_init;

for($i=0;$i<4096;$i++) {
    $mask = 8;
    if ($i == $mon_tr[$mon_idx]) {
	#print stderr "Flipped lo"
	$mon_val = &FlipFlop($mon_val);
	$mon_idx++;
    }
    if ($i == $det_lo_tr[$det_lo_idx]) {
	#print stderr "Flipped lo"
	$det_lo_val = &FlipFlop($det_lo_val);
	$det_lo_idx++;
    }
    if ($i == $det_hi_tr[$det_hi_idx]) {
	#print stderr "Flipped hi"
	$det_hi_val = &FlipFlop($det_hi_val);
	$det_hi_idx++;
    }

    #Short-circuit to leave monitor unmasked
    $mask = 0;
    if ($mon_val)    { $mask += 1; }
    if ($det_lo_val) { $mask += 2; }
    if ($det_hi_val) { $mask += 4; }
    if ($opt_b) {
	# print output in binary (for fast reads)
	$binval = pack "N",$mask;
	print $binval;
    } else {
	printf " %x \n", $mask;
    }
}
